---
import "../styles/tokens.css";
import "../styles/blog.css";
import { url } from "../lib/url";

interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  ogImage?: string;
  structuredData?: object | object[];
}

const {
  title,
  description,
  ogType = "website",
  publishedTime,
  modifiedTime,
  tags = [],
  ogImage = "https://akmalariq.dev/og.png",
  structuredData,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const home = url("/");
const current = Astro.url.pathname;

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Akmal Ariq — Blog",
  url: canonical.origin + home,
  description:
    "Notes on data engineering, storage, and system design — written to be re-read.",
  author: {
    "@type": "Person",
    name: "Akmal Ariq",
    url: "https://akmalariq.dev",
    jobTitle: "Data Analytics & AI Engineer",
    sameAs: ["https://www.linkedin.com/in/akmalariq/"],
  },
};

const blocks = [websiteSchema, ...(Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <link rel="alternate" type="application/rss+xml" title="Akmal Ariq — Blog" href={url("rss.xml")} />

    <meta name="theme-color" content="#0d0d0c" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Akmal Ariq — Blog" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Manrope:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme =
            stored ||
            (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
          document.documentElement.classList.add(theme === "light" ? "light" : "dark");
        } catch (e) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    {blocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="https://akmalariq.dev/">
          akmalariq.dev<span class="brand__accent">.</span>
          <span class="brand__crumb">/blog</span>
        </a>

        <nav class="site-nav" aria-label="Primary">
          <a href={home} aria-current={current === home ? "page" : undefined}>blog</a>
          <a href="https://akmalariq.dev/#projects">work</a>
          <a href="https://akmalariq.dev/#about">about</a>
          <a href={url("rss.xml")}>rss</a>
          <button class="theme-toggle" type="button" aria-label="Toggle theme" onclick="(function(){var d=document.documentElement;var next=d.classList.contains('light')?'dark':'light';d.classList.remove('light','dark');d.classList.add(next);try{localStorage.setItem('theme',next)}catch(e){}})()">
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.5 6.5 0 0 0 9.8 9.8Z"/></svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p>© {new Date().getFullYear()} Akmal Ariq · Data engineering notes</p>
        <p>
          <a href="https://akmalariq.dev/">akmalariq.dev</a> ·
          <a href={url("rss.xml")}>RSS</a> ·
          <a href="https://www.linkedin.com/in/akmalariq/">LinkedIn</a>
        </p>
      </div>
    </footer>
  </body>
</html>
