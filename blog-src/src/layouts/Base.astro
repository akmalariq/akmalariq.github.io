---
import "../styles/tokens.css";
import "../styles/blog.css";
import { url } from "../lib/url";

interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  ogImage?: string;
  structuredData?: object | object[];
}

const {
  title,
  description,
  ogType = "website",
  publishedTime,
  modifiedTime,
  tags = [],
  ogImage = "https://akmalariq.dev/og.png",
  structuredData,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const home = url("/");
const current = Astro.url.pathname;

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Akmal Ariq — Blog",
  url: canonical.origin + home,
  description:
    "Notes on data engineering, storage, and system design — written to be re-read.",
  author: {
    "@type": "Person",
    name: "Akmal Ariq",
    url: "https://akmalariq.dev",
    jobTitle: "Data Analytics & AI Engineer",
    sameAs: ["https://www.linkedin.com/in/akmalariq/"],
  },
};

const blocks = [websiteSchema, ...(Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <link rel="alternate" type="application/rss+xml" title="Akmal Ariq — Blog" href={url("rss.xml")} />

    <meta name="theme-color" content="#0d0d0c" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Akmal Ariq — Blog" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" as="font" type="font/woff2" href="/fonts/manrope.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/ebgaramond-roman.woff2" crossorigin />
    <link rel="stylesheet" href="/css/fonts.css" />

    <!-- Shared site header, identical to the main site and /projects. -->
    <link rel="stylesheet" href="/css/nav.css" />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme =
            stored ||
            (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
          document.documentElement.classList.add(theme === "light" ? "light" : "dark");
        } catch (e) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    {blocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <!-- Canonical header: same markup, links and classes as the main site. -->
    <header class="header" role="banner">
      <div class="container">
        <div class="header-content">
          <div class="header-left">
            <a href="https://akmalariq.dev/" class="header-logo" aria-label="Akmal Ariq - Home">
              <span class="name">Akmal Ariq</span>
              <span class="title">Data Analytics &amp; AI Engineer</span>
            </a>
          </div>
          <nav class="nav" aria-label="Main navigation">
            <a href="https://akmalariq.dev/#solutions" class="nav-link">Services</a>
            <a href="https://akmalariq.dev/projects" class="nav-link">Work</a>
            <a href="https://akmalariq.dev/#pricing" class="nav-link">Pricing</a>
            <a href={home} class="nav-link">Blog</a>
            <a href="https://akmalariq.dev/#about" class="nav-link">About</a>
            <a href="https://akmalariq.dev/#contact" class="btn btn-primary nav-cta">Get in touch</a>
            <button id="themeToggle" class="theme-toggle-btn" type="button" aria-label="Toggle theme mode">
              <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
              <svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
            </button>
          </nav>
          <button class="mobile-menu-btn" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-menu">
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
        <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation" hidden>
          <a href="https://akmalariq.dev/#solutions" class="mobile-nav-link">Services</a>
          <a href="https://akmalariq.dev/projects" class="mobile-nav-link">Work</a>
          <a href="https://akmalariq.dev/#pricing" class="mobile-nav-link">Pricing</a>
          <a href={home} class="mobile-nav-link">Blog</a>
          <a href="https://akmalariq.dev/#about" class="mobile-nav-link">About</a>
          <a href="https://akmalariq.dev/#contact" class="mobile-nav-link">Get in touch</a>
          <button id="themeToggleMobile" class="mobile-nav-link" type="button" style="text-align:left;background:none;border:none;cursor:pointer;">
            Toggle Dark/Light Mode
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p>© {new Date().getFullYear()} Akmal Ariq · Data engineering notes</p>
        <p>
          <a href="https://akmalariq.dev/">akmalariq.dev</a> ·
          <a href={url("rss.xml")}>RSS</a> ·
          <a href="https://www.linkedin.com/in/akmalariq/">LinkedIn</a>
        </p>
      </div>
    </footer>
    <script src="/js/nav.js" defer></script>
  </body>
</html>
