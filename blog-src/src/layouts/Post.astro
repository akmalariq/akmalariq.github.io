---
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import TOC from "../components/TOC.astro";
import CTA from "../components/CTA.astro";
import { url } from "../lib/url";
import { formatDate, isoDate, readingTime } from "../lib/format";

interface Props {
  entry: CollectionEntry<"blog">;
  headings?: { depth: number; slug: string; text: string }[];
}

const { entry, headings = [] } = Astro.props;
const { data } = entry;
const minutes = data.readingTime ?? readingTime(entry.body);
const postUrl = new URL(url(`${entry.slug}/`), Astro.site).href;
const words = entry.body.trim().split(/\s+/).filter(Boolean).length;

const schema = {
  "@type": "BlogPosting",
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updated ?? data.pubDate).toISOString(),
  inLanguage: "en",
  wordCount: words,
  keywords: data.tags.join(", "),
  ...(data.series ? { articleSection: data.series } : {}),
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  author: {
    "@type": "Person",
    name: "Akmal Ariq",
    url: "https://akmalariq.dev",
    jobTitle: "Data Analytics & AI Engineer",
    sameAs: ["https://www.linkedin.com/in/akmalariq/"],
  },
  publisher: { "@type": "Person", name: "Akmal Ariq", url: "https://akmalariq.dev" },
};

const publishedIso = data.pubDate.toISOString();
const modifiedIso = (data.updated ?? data.pubDate).toISOString();
---

<Base
  title={`${data.title} — Akmal Ariq`}
  description={data.description}
  ogType="article"
  publishedTime={publishedIso}
  modifiedTime={modifiedIso}
  tags={data.tags}
  structuredData={schema}
>
  <article class="article container container--narrow">
    <header class="article__header">
      <div class="article__meta">
        <time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate)}</time>
        {data.series && <span class="dot" aria-hidden="true" />}
        {data.series && <span>{data.series}</span>}
        <span class="dot" aria-hidden="true" />
        <span>{data.level}</span>
        <span class="dot" aria-hidden="true" />
        <span>{minutes}</span>
      </div>
      <h1 class="article__title">{data.title}</h1>
      <p class="article__desc">{data.description}</p>
      {
        data.tags.length > 0 && (
          <div class="tag-row" style="margin-top:1.1rem">
            {data.tags.map((tag) => (
              <a class="tag" href={url(`tags/${tag}/`)}>
                {tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <TOC headings={headings} />

    <div class="prose">
      <slot />
    </div>

    <p class="muted" style="margin-top:2.5rem">
      <a href={url("/")}>← All posts</a>
    </p>

    <CTA />
  </article>
</Base>
