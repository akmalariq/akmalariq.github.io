---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { url } from "../../lib/url";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const byTag = new Map<string, typeof posts>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!byTag.has(tag)) byTag.set(tag, []);
      byTag.get(tag)!.push(post);
    }
  }
  return [...byTag.entries()].map(([tag, list]) => ({
    params: { tag },
    props: {
      tag,
      posts: list.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<Base
  title={`#${tag} — Akmal Ariq Blog`}
  description={`Posts tagged “${tag}” on the Akmal Ariq blog.`}
>
  <section class="page-head">
    <div class="container container--narrow">
      <p class="page-head__eyebrow">Tag</p>
      <h1>#{tag}</h1>
      <p>{posts.length} post{posts.length === 1 ? "" : "s"}. <a href={url("/")}>All posts</a></p>
    </div>
  </section>

  <div class="container container--narrow">
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <PostCard post={post} />
        </li>
      ))}
    </ul>
  </div>
</Base>
